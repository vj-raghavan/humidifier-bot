NTFY_TOPIC=your-ntfy-topic
NTFY_URL=https://ntfy.sh/your-ntfy-topic
SHORTCUT_ON_NAME=PH On
SHORTCUT_OFF_NAME=PH Off

HUMIDITY_LOW=50
HUMIDITY_HIGH=60
START_HOUR=7
END_HOUR=20
CHECK_INTERVAL=60

RTSP_URL=rtsp://USER:PASSWORD@CAMERA_IP:554/stream1
FFMPEG_TIMEOUT=15
FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
# ffmpeg crop=w:h:x:y — leave empty for full frame
FFMPEG_CROP=640:380:580:170

VISION_API_BASE=http://127.0.0.1:1234/v1
VISION_MODEL=qwen/qwen3-vl-4b
VISION_API_KEY=lm-studio
# Seconds for each vision HTTP call
VISION_TIMEOUT=60
# Same-frame retries for OCR / 4xx / parse failures
VISION_SOFT_RETRIES=3
VISION_SOFT_RETRY_DELAY=10
# Host unreachable / timeout / 5xx: few attempts then long backoff (seconds)
VISION_HOST_DOWN_RETRIES=1
VISION_HOST_DOWN_RETRY_DELAY=5
VISION_HOST_DOWN_BACKOFF=180
VISION_HOST_DOWN_NTFY=true
VISION_HOST_DOWN_NTFY_SECS=3600

MAX_CONSECUTIVE_FAILURES=3
MAX_ON_WITHOUT_READ_SECS=300
MAX_ON_SECS=1800
MAX_ON_COOLDOWN_SECS=600
HUMIDITY_PLAUSIBLE_MIN=10
HUMIDITY_PLAUSIBLE_MAX=95
MAX_HUMIDITY_JUMP=15
REMOTE_LOCAL_MAX_DELTA=40
SHORTCUTS_BIN=/usr/bin/shortcuts
SHORTCUT_TIMEOUT=30
ON_VERIFY_CHECKS=3
ON_VERIFY_MIN_RISE=2
# Consecutive failed ON-verify windows before empty-tank pause (until cleared)
EMPTY_TANK_FAILS=3
TEST_MODE=false

# Pause file (also used for empty-tank “needs attention”). Override path if you like.
# PAUSE_FILE=/path/to/humidifier_pause.json
PAUSE_LOG_INTERVAL=300

# Morning/evening ntfy from humidity_history.json. Hour -1 disables that slot.
DIGEST_ENABLED=true
DIGEST_MORNING_HOUR=7
DIGEST_EVENING_HOUR=20
# DIGEST_STATE_FILE=/path/to/humidifier_digest.json
HISTORY_MAX_READINGS=1600

# Crop-drift stills + ntfy when OCR/range/split failures streak
CROP_DRIFT_STREAK=4
CROP_DRIFT_NTFY_SECS=3600
CROP_DRIFT_SAVE_FULL=true
# STILLS_DIR=/path/to/stills

# If internal state is already OFF but RH is still high, re-send OFF (plug drift)
FORCE_OFF_SYNC_MARGIN=5
FORCE_OFF_SYNC_INTERVAL=900

# Floor for error/safety ntfy (state-change ON/OFF is not limited)
NTFY_ERROR_MIN_INTERVAL=600
