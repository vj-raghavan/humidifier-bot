NTFY_TOPIC=your-ntfy-topic
NTFY_URL=https://ntfy.sh/your-ntfy-topic
SHORTCUT_ON_NAME=PH On
SHORTCUT_OFF_NAME=PH Off

HUMIDITY_LOW=50
HUMIDITY_HIGH=60
START_HOUR=7
END_HOUR=20
CHECK_INTERVAL=60

RTSP_URL=rtsp://USER:PASSWORD@CAMERA_IP:554/stream1
FFMPEG_TIMEOUT=15
FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
# ffmpeg crop=w:h:x:y — leave empty for full frame (2304×1296 Tapo stills).
# Tight top-LCD box 640:380:580:170 often yields empty Vision OCR.
# Device region (OUT + maybe a sliver of IN). Live Mini crop has been ~640:420:800:360.
# Alternate that also worked: 700:520:750:350
FFMPEG_CROP=640:420:800:360
# Second crop of the *already captured* device frame, humidity digits only (w:h:x:y).
# Leave empty to use the built-in OUT-RH default (~72%×34% box at x=16% y=36% of the device crop).
# Recommended starting point on a 640×420 device crop: 360:140:160:150
FFMPEG_CROP_RH=360:140:160:150

VISION_API_BASE=http://127.0.0.1:1234/v1
VISION_MODEL=qwen/qwen3-vl-4b
VISION_API_KEY=lm-studio
# Seconds for each vision HTTP call
VISION_TIMEOUT=60
# Same-frame retries for OCR / 4xx / parse failures (VISION_MAX_RETRIES is an alias)
VISION_SOFT_RETRIES=3
VISION_SOFT_RETRY_DELAY=10
VISION_MAX_RETRIES=3
VISION_RETRY_DELAY=10
# Host unreachable / timeout / 5xx: few attempts then long backoff (seconds)
VISION_HOST_DOWN_RETRIES=1
VISION_HOST_DOWN_RETRY_DELAY=5
VISION_HOST_DOWN_BACKOFF=180
VISION_HOST_DOWN_NTFY=true
VISION_HOST_DOWN_NTFY_SECS=3600
# Seconds to wait after a failed cycle before recapturing (0 = CHECK_INTERVAL)
FAILED_READ_RETRY_SECS=0
# Extra wait after consecutive-failure safety OFF (0 = 2× CHECK_INTERVAL)
FAILED_READ_BACKOFF_SECS=0

# Humidity read path: local OCR first (Mac Mini), vision LLM fallback (VISION_API_BASE).
# ocr_first | ocr_only | llm_only
HUMIDITY_READ_MODE=ocr_first
# auto | vision | tesseract  (auto prefers Apple Vision on macOS, else tesseract CLI)
OCR_BACKEND=auto
OCR_TIMEOUT=8
OCR_MIN_CONFIDENCE=0.5
OCR_VISION_LEVEL=accurate
# Tesseract CLI fallback (brew install tesseract) if Vision is unavailable
OCR_TESSERACT_BIN=tesseract
OCR_TESSERACT_LANG=eng
# 6 = uniform block of text (two LCD rows). 7 = single line.
OCR_TESSERACT_PSM=6
OCR_TESSERACT_WHITELIST=0123456789.%C
# Preprocess the RH crop before Vision/Tesseract (ffmpeg, Pillow fallback)
OCR_PREPROCESS=1
OCR_UPSCALE=2
OCR_CONTRAST=1.6
# 0 = skip; typical LCD binarize ~140–180 if digits are washed out
OCR_THRESHOLD=0
OCR_INVERT=0
# Multi-frame OCR: N captures ~0.7s apart; need MIN_AGREE values within MAX_DELTA RH points
OCR_CONSENSUS_FRAMES=3
OCR_CONSENSUS_GAP_SECS=0.7
OCR_CONSENSUS_MIN_AGREE=2
OCR_CONSENSUS_MAX_DELTA=2

MAX_CONSECUTIVE_FAILURES=3
MAX_ON_WITHOUT_READ_SECS=300
MAX_ON_SECS=1800
MAX_ON_COOLDOWN_SECS=600
HUMIDITY_PLAUSIBLE_MIN=10
HUMIDITY_PLAUSIBLE_MAX=95
MAX_HUMIDITY_JUMP=15
REMOTE_LOCAL_MAX_DELTA=40
SHORTCUTS_BIN=/usr/bin/shortcuts
SHORTCUT_TIMEOUT=30
ON_VERIFY_CHECKS=3
ON_VERIFY_MIN_RISE=2
# Consecutive failed ON-verify windows before empty-tank pause (until cleared)
EMPTY_TANK_FAILS=3
TEST_MODE=false

# Pause file (also used for empty-tank “needs attention”). Override path if you like.
# PAUSE_FILE=/path/to/humidifier_pause.json
PAUSE_LOG_INTERVAL=300

# Morning/evening ntfy from humidity_history.json. Hour -1 disables that slot.
DIGEST_ENABLED=true
DIGEST_MORNING_HOUR=7
DIGEST_EVENING_HOUR=20
# DIGEST_STATE_FILE=/path/to/humidifier_digest.json
HISTORY_MAX_READINGS=1600

# Crop-drift stills + ntfy when OCR/range/split failures streak
CROP_DRIFT_STREAK=4
CROP_DRIFT_NTFY_SECS=3600
CROP_DRIFT_SAVE_FULL=true
# STILLS_DIR=/path/to/stills

# If internal state is already OFF but RH is still high, re-send OFF (plug drift)
FORCE_OFF_SYNC_MARGIN=5
FORCE_OFF_SYNC_INTERVAL=900

# Floor for error/safety ntfy (state-change ON/OFF is not limited)
NTFY_ERROR_MIN_INTERVAL=600
