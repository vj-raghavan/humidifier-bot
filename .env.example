NTFY_TOPIC=your-ntfy-topic
NTFY_URL=https://ntfy.sh/your-ntfy-topic
SHORTCUT_ON_NAME=PH On
SHORTCUT_OFF_NAME=PH Off

HUMIDITY_LOW=50
HUMIDITY_HIGH=60
START_HOUR=7
END_HOUR=20
CHECK_INTERVAL=60

RTSP_URL=rtsp://USER:PASSWORD@CAMERA_IP:554/stream1
FFMPEG_TIMEOUT=15
FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
# ffmpeg crop=w:h:x:y — leave empty for full frame
FFMPEG_CROP=640:380:580:170

VISION_API_BASE=http://127.0.0.1:1234/v1
VISION_MODEL=qwen/qwen3-vl-4b
VISION_API_KEY=lm-studio
# Same-frame retries when vLLM HTTP/parse/humidity resolution fails
VISION_MAX_RETRIES=3
VISION_RETRY_DELAY=10
VISION_TIMEOUT=60
# Seconds to wait after a failed cycle before recapturing (0 = CHECK_INTERVAL)
FAILED_READ_RETRY_SECS=0
# Extra wait after consecutive-failure safety OFF (0 = 2× CHECK_INTERVAL)
FAILED_READ_BACKOFF_SECS=0

MAX_CONSECUTIVE_FAILURES=3
MAX_ON_WITHOUT_READ_SECS=300
MAX_ON_SECS=1800
MAX_ON_COOLDOWN_SECS=600
HUMIDITY_PLAUSIBLE_MIN=10
HUMIDITY_PLAUSIBLE_MAX=95
MAX_HUMIDITY_JUMP=15
REMOTE_LOCAL_MAX_DELTA=40
SHORTCUTS_BIN=/usr/bin/shortcuts
SHORTCUT_TIMEOUT=30
ON_VERIFY_CHECKS=3
ON_VERIFY_MIN_RISE=2
TEST_MODE=false
